flowchart TD
    %% ============================================================================
    %% CANDY AND ROSE SALON MANAGEMENT INFORMATION SYSTEM
    %% Traditional Chen Notation ERD (Mermaid Flowchart Representation)
    %% Conventions:
    %%   [ENTITY]     = Strong Entity (Rectangle)
    %%   [[ENTITY]]   = Dependent / Identifying Entity (Double Rectangle)
    %%   {REL}        = Relationship (Diamond)
    %%   ([attr])     = Attribute (Oval)
    %%   <u>id</u>    = Primary Key Attribute (Underlined)
    %% ============================================================================

    classDef entity fill:#EC4899,stroke:#831843,stroke-width:2.5px,color:#FFFFFF,font-weight:bold;
    classDef authEntity fill:#1E293B,stroke:#0F172A,stroke-width:2.5px,color:#FFFFFF,font-weight:bold;
    classDef rel fill:#FDF2F8,stroke:#BE185D,stroke-width:2px,color:#831843,font-weight:bold;
    classDef pkAttr fill:#FEF3C7,stroke:#D97706,stroke-width:2px,color:#92400E,font-weight:bold;
    classDef fkAttr fill:#FCE7F3,stroke:#DB2777,stroke-width:1.5px,stroke-dasharray: 4 2,color:#9D174D;
    classDef uqAttr fill:#E0F2FE,stroke:#0284C7,stroke-width:1.5px,color:#075985;
    classDef attr fill:#FFFFFF,stroke:#64748B,stroke-width:1.2px,color:#1E293B;

    %% ============================================================================
    %% 1. USER, AUTHENTICATION & ACCOUNT MANAGEMENT
    %% ============================================================================
    AUTH_USERS["AUTH.USERS"]:::authEntity
    AU_id(["<u>id (PK)</u>"]):::pkAttr --- AUTH_USERS
    AU_email(["email"]):::attr --- AUTH_USERS
